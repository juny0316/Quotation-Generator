# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. .env.local 은 git에 올라가지 않습니다.
# 배포 서버(Vercel)는 이 파일이 아니라 Vercel → Settings → Environment Variables 값을 씁니다.

# 팀 공용 로그인 비밀번호
APP_PASSWORD=

# Supabase → Project Settings → Data API 의 Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)
SUPABASE_SECRET_KEY=

# 로컬 테스트 서버(node test/dev-server.js)가 실제 Supabase에 연결할지 (1 = 실제 DB, 비우면 메모리 모의 DB)
# 실제 DB에 연결하면 테스트로 만든 견적도 운영 데이터에 저장되니 주의하세요.
USE_REAL_SUPABASE=
