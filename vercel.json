{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "functions": {
    "api/docs.js": { "maxDuration": 30 },
    "api/login.js": { "maxDuration": 10 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] }
  ]
}
